{
	"seed": 8,
	"data": {
		"wav_dir": "/mnt/local-scratch/Yuna",
		"sampling_rate": 48000,
		"num_samples": 96000,
		"batch_size": 16,
		"num_workers": 4,
		"eval_index": 0
	},
	"feature_extractor": {
		"sample_rate": 48000,
		"n_fft": 2048,
		"hop_length": 256,
		"n_mels": 128,
		"f_min": 0.0,
		"f_max": 24000.0,
		"padding": "same",
		"mel_mean": -4.0,
		"mel_std": 4.0
	},
	"backbone": {
		"input_channels": 128,
		"dim": 512,
		"intermediate_dim": 1536,
		"num_layers": 12
	},
	"head": {
		"dim": 512,
		"n_fft": 2048,
		"hop_length": 256,
		"padding": "same"
	},
	"model": {
		"sample_rate": 48000,
		"initial_learning_rate": 5e-4,
		"mel_loss_coeff": 45,
