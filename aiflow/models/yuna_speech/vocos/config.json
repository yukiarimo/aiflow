		"num_warmup_steps": 0,
		"pretrain_mel_steps": 0,
		"decay_mel_coeff": false
	},
	"trainer": {
		"save_dir": "logs",
		"max_steps": 2000000,
		"limit_val_batches": 100,
		"log_every_n_steps": 100,
		"save_top_k": 3,
		"precision": "bf16-mixed"
	}
}
