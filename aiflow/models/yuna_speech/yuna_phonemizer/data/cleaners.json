{
	"abbreviations": [
		["\\bdr\\.", "Doctor"],
		["\\bmr\\.", "Mister"],
		["\\bmrs\\.", "Missus"],
		["\\bms\\.", "Miss"],
		["\\bst\\.", "Saint"],
		["\\bdrs\\.", "Doctors"],
		["\\bprof\\.", "Professor"],
		["\\bjr\\.", "Junior"],
		["\\bsr\\.", "Senior"],
		["\\bno\\.", "number"],
		["\\bapprox\\.", "approximately"],
		["\\bdept\\.", "department"],
		["\\bu\\.s\\.a\\.?", "USA"],
		["\\bu\\.s\\.s\\.r\\.?", "USSR"],
		["\\bu\\.s\\.", "US"],
		["\\bd\\.c\\.", "DC"],
		["\\bave\\.", "Avenue"],
		["\\bblvd\\.", "Boulevard"],
		["\\brd\\.", "Road"],
		["\\bhwy\\.", "Highway"],
		["\\bu\\.n\\.", "UN"],
		["\\be\\.g\\.", "for example"],
		["\\bi\\.e\\.", "that is"],
		["\\betc\\.", "etcetera"],
		["\\ba\\.s\\.m\\.r\\.?", "ASMR"],
		["\\ba\\.m\\.", "AM"],
		["\\bp\\.m\\.", "PM"],
		["\\bvs\\.", "versus"],
		["\\binc\\.", "Incorporated"],
		["\\bain't\\b", "am not"]
	],
	"initials_re": "(^|\\s)([A-Z])\\.(?=\\s|$|[.,;:!?])",
	"currency_map": {
		"$": { "en-us": ["dollar", "dollars"], "ru": ["доллар", "доллара", "долларов"], "ja": "doru" },
		"€": { "en-us": ["euro", "euros"], "ru": ["евро", "евро", "евро"], "ja": "yuro" },
		"£": { "en-us": ["pound", "pounds"], "ru": ["фунт", "фунта", "фунтов"], "ja": "pondo" },
		"¥": { "en-us": ["yen", "yen"], "ru": ["иен", "иен", "иен"], "ja": "en" },
		"₽": { "en-us": ["ruble", "rubles"], "ru": ["рубль", "рубля", "рублей"], "ja": "ruuburu" }
	},
	"suffix_map": {
		"K": { "en-us": "thousand", "ru": "тысяч", "ja": "sen" },
		"M": { "en-us": "million", "ru": "миллионов", "ja": "mirion" },
		"B": { "en-us": "billion", "ru": "миллиардов", "ja": "birion" },
		"T": { "en-us": "trillion", "ru": "триллионов", "ja": "toririon" }
	},
	"sci_words": { "en-us": " times 10 to the ", "ru": " умножить на десять в степени ", "ja": " kakeru juu no " },
	"to_words": { "en-us": " to ", "ru": " до ", "ja": " kara " },
	"point_words": { "en-us": " point ", "ru": " точка ", "ja": " ten " },
	"currency_re": "([$€£¥₽])\\s*(\\d+(?:\\.\\d+)?)\\s*([KkMmBbTt]\\b)?",
	"currency_rev_re": "(\\d+(?:\\.\\d+)?)\\s*([KkMmBbTt]\\b)?\\s*([$€£¥₽])",
	"suffix_num_re": "\\b(\\d+(?:\\.\\d+)?)\\s*([KkMmBbTt])\\b",
	"sci_re": "(\\d+(?:\\.\\d+)?)[eE]([+-]?\\d+)",
	"range_re": "(\\d+)\\s*-\\s*(\\d+)",
	"decimal_re": "(\\d+)\\s*\\.\\s*(\\d+)",
	"urls_re": "https?://\\S+|www\\.\\S+",
	"number_commas_re": "(?<=\\d)\\s*,\\s*(?=\\d)",
	"roman_values": { "I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000 },
	"roman_exclude": ["DC", "MD", "CD", "CV", "IV", "MC", "DIV", "BC", "AD"],
	"roman_valid_re": "^(M{0,4})(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})$",
	"roman_match_re": "(?<![\\d'])\\b[MDCLXVI]+\\b(?![\\d'])",
	"language_map": { "en-us": "en-us", "ru": "ru", "ja": "ja" }
}
